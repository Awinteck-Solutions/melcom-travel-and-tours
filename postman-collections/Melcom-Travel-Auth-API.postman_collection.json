            "url": {
              "raw": "{{baseUrl}}/auth/notification-alerts",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "notification-alerts"]
            }
          },
          "response": []
        },
        {
          "name": "Update Notification Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
