              },
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"read\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/notification-alerts/:id",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "notification-alerts", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "notification_id_here"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
