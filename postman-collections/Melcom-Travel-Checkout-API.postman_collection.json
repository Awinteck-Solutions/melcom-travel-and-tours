                  "    const response = pm.response.json();",
                  "    if (response.success && response.data) {",
                  "        pm.collectionVariables.set('familyCheckoutId', response.data.checkoutId);",
                  "        pm.collectionVariables.set('familyBookingReference', response.data.bookingReference);",
                  "        console.log('Family checkout created:', response.data.bookingReference);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
