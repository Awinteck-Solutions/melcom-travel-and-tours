            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flight\": {\n    \"id\": 2,\n    \"from\": \"Accra Kotoka (ACC)\",\n    \"fromCode\": \"ACC\",\n    \"to\": \"London Heathrow (LHR)\",\n    \"toCode\": \"LHR\",\n    \"airlineLogo\": \"/british-airways.svg\",\n    \"departure\": \"2025-12-15T14:30:00.000Z\",\n    \"arrival\": \"2025-12-15T22:45:00.000Z\",\n    \"airline\": \"BRITISH AIRWAYS\",\n    \"planeType\": \"B777\",\n    \"flightType\": \"one-way\",\n    \"returnDate\": null,\n    \"price\": 2500,\n    \"duration\": \"6h 15m\",\n    \"stops\": 0,\n    \"flightNumber\": \"BA78\",\n    \"class\": \"Economy\",\n    \"segment\": [\n      {\n        \"flightNumber\": \"BA78\",\n        \"airline\": \"BRITISH AIRWAYS\",\n        \"aircraft\": \"B777\",\n        \"departure\": {\n          \"airport\": \"ACC\",\n          \"time\": \"2025-12-15T14:30:00\",\n          \"terminal\": \"3\"\n        },\n        \"arrival\": {\n          \"airport\": \"LHR\",\n          \"time\": \"2025-12-15T22:45:00\",\n          \"terminal\": \"5\"\n        },\n        \"duration\": \"PT6H15M\",\n        \"cabinClass\": \"Economy\"\n      }\n    ],\n    \"bookingReference\": \"PD002\",\n    \"currency\": \"GHS\",\n    \"perPassenger\": 2500,\n    \"segments\": [\n      {\n        \"flightNumber\": \"BA78\",\n        \"airline\": \"BRITISH AIRWAYS\",\n        \"aircraft\": \"B777\",\n        \"departure\": {\n          \"airport\": \"ACC\",\n          \"time\": \"2025-12-15T14:30:00\",\n          \"terminal\": \"3\"\n        },\n        \"arrival\": {\n          \"airport\": \"LHR\",\n          \"time\": \"2025-12-15T22:45:00\",\n          \"terminal\": \"5\"\n        },\n        \"duration\": \"PT6H15M\",\n        \"cabinClass\": \"Economy\"\n      }\n    ],\n    \"totalSegments\": 1,\n    \"firstAirline\": \"BRITISH AIRWAYS\",\n    \"firstAirlineCode\": \"BA\"\n  },\n  \"Traveler\": [\n    {\n      \"PassengerType\": \"ADT\",\n      \"BirthDate\": \"1985-03-20\",\n      \"Passport\": \"G87654321\",\n      \"LoyaltyProgram\": \"BA123456\",\n      \"Gender\": \"Male\",\n      \"NamePrefix\": \"Mr\",\n      \"GivenName\": \"Michael\",\n      \"Surname\": \"Smith\",\n      \"email\": \"michael.smith@example.com\",\n      \"phone\": \"+233241234567\"\n    },\n    {\n      \"PassengerType\": \"ADT\",\n      \"BirthDate\": \"1988-07-12\",\n      \"Passport\": \"G11223344\",\n      \"LoyaltyProgram\": \"\",\n      \"Gender\": \"Female\",\n      \"NamePrefix\": \"Mrs\",\n      \"GivenName\": \"Sarah\",\n      \"Surname\": \"Smith\",\n      \"email\": \"sarah.smith@example.com\",\n      \"phone\": \"+233241234567\"\n    },\n    {\n      \"PassengerType\": \"CHD\",\n      \"BirthDate\": \"2015-11-08\",\n      \"Passport\": \"G55667788\",\n      \"LoyaltyProgram\": \"\",\n      \"Gender\": \"Male\",\n      \"NamePrefix\": \"Master\",\n      \"GivenName\": \"James\",\n      \"Surname\": \"Smith\",\n      \"email\": \"michael.smith@example.com\",\n      \"phone\": \"+233241234567\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout/create",
              "host": ["{{baseUrl}}"],
              "path": ["api", "checkout", "create"]
            }
          },
          "response": []
        },
        {
          "name": "Check Payment Status",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.data) {",
                  "        console.log('Payment Status:', response.data.paymentStatus);",
                  "        console.log('Booking Status:', response.data.status);",
                  "        console.log('Transaction ID:', response.data.transactionId);",
                  "        console.log('GOL Reservation ID:', response.data.golReservationId);",
                  "        ",
                  "        // Test that status check was performed",
                  "        pm.test('Should have valid status', function () {",
                  "            pm.expect(['PENDING', 'CONFIRMED', 'FAILED', 'CANCELLED']).to.include(response.data.status);",
                  "        });",
                  "        ",
                  "        pm.test('Should have valid payment status', function () {",
                  "            pm.expect(['PENDING', 'PAID', 'FAILED', 'REFUNDED']).to.include(response.data.paymentStatus);",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/checkout/status/{{checkoutId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "checkout", "status", "{{checkoutId}}"]
            }
          },
          "response": []
        },
        {
          "name": "Get All Checkouts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success && response.data) {",
                  "        console.log('Total checkouts:', response.data.length);",
                  "        response.data.forEach((checkout, index) => {",
                  "            console.log(`Checkout ${index + 1}: ${checkout.bookingReference} - ${checkout.status}`);",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{authToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/checkout/",
              "host": ["{{baseUrl}}"],
              "path": ["api", "checkout", ""]
            }
          },
          "response": []
        }
      ],
      "description": "Checkout management endpoints for creating and tracking flight bookings"
    },
    {
      "name": "Payment Processing",
      "item": [
        {
          "name": "Hubtel Payment Callback - Success",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    if (response.success) {",
                  "        console.log('Payment callback processed successfully');",
                  "        console.log('Final Status:', response.data.status);",
                  "        console.log('Payment Status:', response.data.paymentStatus);",
                  "        console.log('Hubtel Status Check:', response.data.hubtelStatusCheck);",
                  "        ",
                  "        // Test that callback was processed successfully",
                  "        pm.test('Should process callback successfully', function () {",
                  "            pm.expect(response.success).to.be.true;",
                  "        });",
                  "        ",
                  "        pm.test('Should have valid final status', function () {",
                  "            pm.expect(['CONFIRMED', 'FAILED']).to.include(response.data.status);",
                  "        });",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ResponseCode\": \"0000\",\n  \"ResponseText\": \"Success\",\n  \"Data\": {\n    \"CheckoutId\": \"{{checkoutId}}\",\n    \"ClientReference\": \"{{bookingReference}}\",\n    \"Amount\": 1842.00,\n    \"Status\": \"Success\",\n    \"TransactionId\": \"TXN123456789\",\n    \"Description\": \"Flight Booking Payment - Single Passenger\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/checkout/payment/callback",
              "host": ["{{baseUrl}}"],
              "path": ["api", "checkout", "payment", "callback"]
            }
          },
          "response": []
        },
