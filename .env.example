# Database Configuration
DB_URL=mongodb://localhost:27017/melcom-travels

# Server Configuration
PORT=4000

# JWT Configuration - CHANGE THIS IN PRODUCTION!
JWT_SECRET=your_super_secret_jwt_key_here

# GOL API Configuration (Flight Provider)
# Get these credentials from GOL API provider
GOL_API_BASE_URL=https://golapi.golibe.com/api
GOL_API_KEY=your_gol_api_key_here

# Email Configuration
# Configure your SMTP settings for sending emails
MAIL_HOST=your_mail_host
MAIL_USERNAME=your_email_username
MAIL_PASSWORD=your_email_password

# Development/Production Environment
NODE_ENV=development