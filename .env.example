# GOL API Configuration
GOL_API_CLIENT_ID=your-gol-client-id
GOL_API_PASSWORD=your-gol-password
GOL_API_BASE_URL=https://golapi.golibe.com

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/melcom-travels

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=7d

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Server Configuration
PORT=3000
NODE_ENV=development